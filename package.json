{
  "name": "rollup-require-esm",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.2.1",
  "description": "Example repo for require(esm) in Rollup",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/antfu/rollup-require-esm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/rollup-require-esm.git"
  },
  "bugs": "https://github.com/antfu/rollup-require-esm/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "lint": "eslint .",
    "release": "bumpp && pnpm publish",
    "start": "node src/index.js",
    "start:dist": "node dist/index.js",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.1.1",
    "@antfu/ni": "^23.3.1",
    "@antfu/utils": "^8.1.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/node": "^22.13.1",
    "bumpp": "^10.0.2",
    "debug": "^4.4.0",
    "eslint": "^9.20.0",
    "lint-staged": "^15.4.3",
    "ms": "^2.1.3",
    "rollup": "^4.34.6",
    "rollup-plugin-dts": "^6.1.1",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "patchedDependencies": {
      "ms": "patches/ms.patch"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
